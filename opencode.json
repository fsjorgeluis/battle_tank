{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "opsx-explore": {
      "description": "Explores and analyzes an OpenSpec change without implementing application code.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/deepseek-v4-flash-free",
      "permissions": [
        { "action": "file:write", "effect": "deny" },
        { "action": "bash", "effect": "deny" }
      ]
    },
    "opsx-apply": {
      "description": "Implements an OpenSpec change in the codebase.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/big-pickle"
    },
    "opsx-archive": {
      "description": "Archives a completed OpenSpec change.",
      "mode": "subagent",
      "hidden": true,
      "model": "opencode/big-pickle"
    }
  }
}
